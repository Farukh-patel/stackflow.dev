# Razorpay Configuration
# Get your Razorpay API credentials from: https://dashboard.razorpay.com/app/keys
# For testing, use test mode keys
# For production, use live mode keys
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (optional, but recommended for production)
# Get from Razorpay Dashboard → Settings → Webhooks → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Application URLs
# Set this to your frontend URL (e.g., http://localhost:5173 for Vite dev server)
# For production, use your actual domain (e.g., https://yourdomain.com)
CLIENT_URL=http://localhost:5173

# Server URL (required for webhooks)
# For local development, use your local server URL or ngrok tunnel for webhooks
# For production, use your actual server domain
SERVER_URL=http://localhost:5000

# MongoDB Configuration
# Get your MongoDB connection string from MongoDB Atlas or your MongoDB instance
# Format: mongodb://username:password@host:port/database
# Or: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/onlineshopping
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Configuration
PORT=5000

